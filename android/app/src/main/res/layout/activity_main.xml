<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/deep_background"
    android:padding="16dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/system_tag"
            android:textColor="@color/primary_cyan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <Button
            android:id="@+id/btnFloat"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/btn_minimize"
            android:textColor="@color/primary_cyan"
            android:background="@drawable/bg_btn_ctrl"
            android:paddingHorizontal="14dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="⚙"
            android:textColor="@color/primary_cyan"
            android:background="@drawable/bg_btn_ctrl"
            android:paddingHorizontal="12dp" />

    </LinearLayout>

    <!-- Central Arc Reactor Hologram View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="center">

        <com.jarvis.mobile.HologramView
            android:id="@+id/hologramView"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center" />

    </FrameLayout>

    <!-- Status Text -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/status_ready"
        android:textColor="@color/primary_cyan"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_btn_ctrl"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <!-- Conversation HUD Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_hud_box"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE COMMUNICATIONS"
            android:textColor="@color/border_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Good day, sir. J.A.R.V.I.S is online on your mobile device. Tap TALK to give voice instructions."
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />
        </ScrollView>

        <TextView
            android:id="@+id/tvUserTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Awaiting input..."
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:textStyle="italic"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnMute"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/btn_voice"
            android:textColor="@color/primary_cyan"
            android:background="@drawable/bg_btn_ctrl"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnTalk"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1.8"
            android:text="@string/btn_talk"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_talk"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/btn_stop"
            android:textColor="@color/danger_red"
            android:background="@drawable/bg_btn_ctrl" />

    </LinearLayout>

</LinearLayout>
